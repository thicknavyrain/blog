{% set pageScripts = (pageScripts or []).concat(["/assets/js/sidenotes.js?v=2"]) %}
{% include "header.html" %}
<article class="page">
  <p class="kicker">Blog</p>
  <h1>{{ title }}</h1>
  <p class="meta">
    {{ date | formatPostDate }} • {{ content | readTimeFromContent }}{% if tags %} •
    Tags: {{ tags }}{% endif %}
  </p>

  {{ content | safe }}
  <div class="mark-center">{% include "cos-mark.njk" %}</div>
</article>
{% include "footer.html" %}
